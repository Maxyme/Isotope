@@ -2295,6 +2377,15 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
     wm->system = system;
 
     update_load_config( *module );
+#ifdef __x86_64__
+    if (!is_builtin)
+    {
+        BOOL did_redirect;
+        if ((status = nucleon_redirect_steamclient( wm, load_path, &did_redirect ))) return status;
+        if (did_redirect) flags |= LDR_DONT_RESOLVE_REFS;
+    }
+#endif
+
 
     /* fixup imports */
 
@@ -4468,6 +4559,9 @@ void loader_init( CONTEXT *context, void **entry )
         void *ntdll_module;
