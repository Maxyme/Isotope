+    out = isotope_fault_hex( out, " pc=", PC_sig(context) );
+    out = isotope_fault_hex( out, " lr=", LR_sig(context) );
+    out = isotope_fault_hex( out, " sp=", SP_sig(context) );
+    out = isotope_fault_hex( out, " fault=", fault );
+    out = isotope_fault_hex( out, " guest_window=", base );
