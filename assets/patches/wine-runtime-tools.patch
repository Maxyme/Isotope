diff --git a/include/wine/isotope_supervisor.h b/include/wine/isotope_supervisor.h
new file mode 100644
index 0000000..9518056
--- /dev/null
+++ b/include/wine/isotope_supervisor.h
@@ -0,0 +1,66 @@
+/* Optional launcher-lifetime backstop for Isotope. LGPL-2.1-or-later. */
+#ifndef WINE_ISOTOPE_SUPERVISOR_H
+#define WINE_ISOTOPE_SUPERVISOR_H
+#ifdef __APPLE__
+#include <sys/event.h>
+#include <sys/types.h>
+#include <pthread.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static void *isotope_supervisor_wait( void *arg )
+{
+    int fd = (int)(intptr_t)arg, count;
+    struct kevent event;
+    do count = kevent( fd, NULL, 0, &event, 1, NULL ); while (count < 0 && errno == EINTR);
+    close( fd );
+    /* Only terminate this process; the kernel binds the event to the registered
+     * process, so a recycled PID cannot identify an unrelated launcher. */
+    if (count == 1 && event.filter == EVFILT_PROC && (event.fflags & NOTE_EXIT)) _exit(137);
+    if (count != 1) _exit(125);
+    return NULL;
+}
+
+static void isotope_supervisor_init(void)
+{
+    const char *value = getenv("ISOTOPE_SUPERVISOR_PID");
+    char *end;
+    long pid;
+    int fd, error;
+    pthread_t thread;
+    struct kevent event;
+    if (!value || !*value) return;
+    errno = 0;
+    pid = strtol( value, &end, 10 );
+    if (errno || *end || pid <= 1 || pid > INT_MAX || pid == getpid())
+    {
+        fputs("isotope: invalid ISOTOPE_SUPERVISOR_PID\n", stderr);
+        _exit(125);
+    }
+    if ((fd = kqueue()) == -1 || fcntl( fd, F_SETFD, FD_CLOEXEC ) == -1) goto failed;
+    EV_SET( &event, pid, EVFILT_PROC, EV_ADD | EV_ENABLE | EV_ONESHOT, NOTE_EXIT, 0, NULL );
+    if (kevent( fd, &event, 1, NULL, 0, NULL ) == -1)
+    {
+        if (errno == ESRCH) _exit(137); /* owner exited before registration */
+        goto failed;
+    }
+    if ((error = pthread_create( &thread, NULL, isotope_supervisor_wait, (void *)(intptr_t)fd )))
+    {
+        errno = error;
+        goto failed;
+    }
+    pthread_detach( thread );
+    return;
+failed:
+    perror("isotope: supervisor registration");
+    _exit(125);
+}
+#else
+static void isotope_supervisor_init(void) {}
+#endif
+#endif
