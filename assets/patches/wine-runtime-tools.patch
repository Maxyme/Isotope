+static char *isotope_fault_hex( char *out, const char *label, ULONG_PTR value )
+{
+    unsigned int i;
+    while (*label) *out++ = *label++;
+    for (i = 0; i < sizeof(value) * 2; i++)
+        *out++ = "0123456789abcdef"[(value >> ((sizeof(value) * 2 - i - 1) * 4)) & 15];
+    return out;
