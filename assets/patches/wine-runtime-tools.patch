+        label[2] += i;
+        out = isotope_fault_hex( out, label, REGn_sig(i, context) );
+    }
+    *out++ = '\n';
+    /* One bounded write preserves a usable record even if the process dies. */
+    write( STDERR_FILENO, line, out - line );
