diff --git a/CMakeLists.txt b/CMakeLists.txt
index 71d8a73..740bf45 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,19 @@ elseif (processor MATCHES "^aarch64|^arm64|^armv8\.*")
     set(ARCHITECTURE_arm64ec 1)
     add_compile_definitions(ARCHITECTURE_arm64ec=1)
   endif()
+
+  # Windows modules for Wine on an arm64 Darwin host: the kernel does not preserve x18, so the TEB is
+  # read from the pthread TSD slot Wine keeps it in (byte offset from TPIDRRO_EL0; Wine's
+  # -D__WINE_TEB_TSD_OFFSET) instead of from x18.
+  set(FEX_TEB_TSD_OFFSET "" CACHE STRING "TSD slot offset of the TEB on arm64 Darwin hosts, empty for x18")
+  if (FEX_TEB_TSD_OFFSET)
+    add_compile_definitions(FEX_TEB_TSD_OFFSET=${FEX_TEB_TSD_OFFSET})
+  endif()
+  option(FEX_GUEST_ADDRESS_WINDOW "32-bit guest address space lives at a 4 GB-aligned host window (arm64 Darwin hosts)" FALSE)
+  # Only the WoW64 module runs 32-bit guests; the ARM64EC module's register set has no room for the window registers.
+  if (FEX_GUEST_ADDRESS_WINDOW AND NOT MINGW_TRIPLE MATCHES "arm64ec")
+    add_compile_definitions(FEX_GUEST_ADDRESS_WINDOW=1)
+  endif()
 endif()
 
 if (NOT (ARCHITECTURE_arm64 OR ARCHITECTURE_arm64ec OR ARCHITECTURE_x86_64))
@@ -341,6 +354,10 @@ endif()
 if (ENABLE_FEX_ALLOCATOR)
   # The rpmalloc subproject that all FEXCore fextl objects allocate through.
   add_subdirectory(External/rpmalloc/)
+  if (MINGW AND FEX_TEB_TSD_OFFSET)
+    # rpmalloc tells threads apart by NtCurrentTeb(), which mingw reads from x18.
+    target_compile_options(rpmalloc PRIVATE -include ${CMAKE_CURRENT_SOURCE_DIR}/Source/Windows/include/TEBFromTSD.h)
+  endif()
 elseif (NOT MINGW)
   message (STATUS
     " FEX allocator is disabled!\n"
